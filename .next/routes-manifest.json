{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/",
      "destination": "/home",
      "statusCode": 308,
      "regex": "^(?!/_next)/(?:/)?$"
    },
    {
      "source": "/index.html",
      "destination": "/home",
      "statusCode": 308,
      "regex": "^(?!/_next)/index\\.html(?:/)?$"
    },
    {
      "source": "/home.html",
      "destination": "/home",
      "statusCode": 308,
      "regex": "^(?!/_next)/home\\.html(?:/)?$"
    },
    {
      "source": "/services",
      "destination": "/service",
      "statusCode": 308,
      "regex": "^(?!/_next)/services(?:/)?$"
    },
    {
      "source": "/services.html",
      "destination": "/service",
      "statusCode": 308,
      "regex": "^(?!/_next)/services\\.html(?:/)?$"
    },
    {
      "source": "/service.html",
      "destination": "/service",
      "statusCode": 308,
      "regex": "^(?!/_next)/service\\.html(?:/)?$"
    },
    {
      "source": "/book.html",
      "destination": "/book",
      "statusCode": 308,
      "regex": "^(?!/_next)/book\\.html(?:/)?$"
    },
    {
      "source": "/book-a-ride",
      "destination": "/book",
      "statusCode": 308,
      "regex": "^(?!/_next)/book-a-ride(?:/)?$"
    },
    {
      "source": "/book-a-ride.html",
      "destination": "/book",
      "statusCode": 308,
      "regex": "^(?!/_next)/book-a-ride\\.html(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/[[...slug]]",
      "regex": "^(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^(?:/(?<nxtPslug>.+?))?(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/booking",
      "regex": "^/api/booking(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/booking(?:/)?$"
    },
    {
      "page": "/api/contact",
      "regex": "^/api/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/contact(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}