        <header class="site-header">
            <div class="container"><a href="/home" class="brand"><img class="brand-mark"
                        src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                        Passage<span>LIMOUSINES</span></span></a>
                <nav class="nav-primary"><a href="/home">Home</a><a href="/about">About</a><a
                        href="/service">Services</a><a href="/fleet">Fleet</a><a href="/book">Book a
                        Ride</a><a href="/faq">FAQ</a><a href="/contact">Contact</a></nav>
                <div class="header-actions"><a href="tel:+16723773932" class="call-chip">(672) 377-3932</a><a
                        href="/book?occasion=Airport%20Transfers" class="btn btn-primary btn-sm">Book a
                        Ride</a><button class="nav-toggle" aria-label="Toggle menu"
                        aria-expanded="false"><span></span></button></div>
            </div>
        </header>
        <main>
            <section class="page-hero">
                <div class="container">
                    <p class="eyebrow">Airport Transfers</p>
                    <h1>Surrey to YVR Airport Limo Service.</h1>
                    <p class="lede">Start or finish your trip without the parking, traffic or timing guesswork. Your
                        chauffeur will get you to Vancouver International Airport with a clear plan.</p>
                    <div class="hero-actions"><a href="/book?occasion=Airport%20Transfers"
                            class="btn btn-primary">Book an Airport Transfer</a><a href="tel:+16723773932"
                            class="btn btn-ghost">Call (672) 377-3932</a></div>
                </div>
            </section>
            <section>
                <div class="container">
                    <div class="section-head">
                        <div class="stack">
                            <p class="eyebrow">A smoother airport day</p>
                            <h2>Reliable transport from Surrey to YVR.</h2>
                        </div>
                    </div>
                    <div class="grid grid-3">
                        <article class="card">
                            <h3>Planned around your flight</h3>
                            <p>Tell us your flight time and pickup location so we can build a practical departure plan
                                around airport check-in.</p>
                        </article>
                        <article class="card">
                            <h3>Door-to-terminal service</h3>
                            <p>Enjoy direct pickup from your home, hotel or office in Surrey and a comfortable ride to
                                the YVR terminal.</p>
                        </article>
                        <article class="card">
                            <h3>Groups and luggage</h3>
                            <p>Choose the vehicle that suits your party and luggage, including stretch limousines and
                                larger party buses for groups.</p>
                        </article>
                    </div>
                </div>
            </section>
            <section class="cta-band">
                <div class="container">
                    <p class="eyebrow center">Flying from Vancouver</p>
                    <h2>Reserve your airport ride.</h2>
                    <p class="lede center">Send your flight details and pickup address to receive a tailored airport
                        transfer quote.</p>
                    <div class="hero-actions"><a href="/book?occasion=Airport%20Transfers"
                            class="btn btn-primary">Request a Quote</a><a href="/contact"
                            class="btn btn-ghost">Contact Us</a></div>
                </div>
            </section>
        </main>
        <footer class="site-footer">
            <div class="container">
                <div class="footer-top">
                    <div class="footer-brand"><a href="/home" class="brand"><img class="brand-mark"
                                src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                                Passage<span>LIMOUSINES</span></span></a>
                        <p>Chauffeured limousines and party buses across Surrey, Metro Vancouver, the Fraser Valley and
                            Whistler.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <ul>
                            <li><a href="/service">Services</a></li>
                            <li><a href="/fleet">Our Fleet</a></li>
                            <li><a href="/faq">FAQ</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Book</h4>
                        <ul>
                            <li><a href="/book">Book a Ride</a></li>
                            <li><a href="tel:+16723773932">(672) 377-3932</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Address</h4>
                        <ul>
                            <li>1959 152 St</li>
                            <li>Surrey, BC</li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom"><span>© <span data-year></span> Posh Passage Limousines. All rights
                        reserved.</span><span>1959 152 St, Surrey, BC</span></div>
            </div>
        </footer>
