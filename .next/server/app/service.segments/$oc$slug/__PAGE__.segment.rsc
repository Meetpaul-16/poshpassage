1:"$Sreact.fragment"
2:T49f0,

    <header class="site-header">
      <div class="container">
        <a href="/home" class="brand">
          <img class="brand-mark" src="/images/posh-passage-logo.png" alt="">
          <span class="brand-word">Posh Passage<span>LIMOUSINES</span></span>
        </a>
        <nav class="nav-primary">
          <a href="/home">Home</a>
          <a href="/about">About</a>
          <a href="/service">Services</a>
          <a href="/fleet">Fleet</a>
          <a href="/book">Book a Ride</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
        </nav>
        <div class="header-actions">
          <a href="tel:+16723773932" class="call-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            (672) 377-3932
          </a>
          <a href="/book" class="btn btn-primary btn-sm">Book a Ride</a>
          <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false"><span></span></button>
        </div>
      </div>
    </header>

    <main>

      <section class="page-hero">
        <div class="container">
          <p class="eyebrow">Services</p>
          <h1>Limousine &amp; Party Bus<br>Services in Metro Vancouver.</h1>
          <p class="lede">Pick your occasion below and we'll pre-fill the booking form — or call us if you'd rather talk
            it through.</p>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="grid grid-3">

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M3 11l18-8-8 18-2-8-8-2z" />
                </svg></div>
              <h3>Airport Transfers</h3>
              <p>YVR and Abbotsford Airport pickups and drop-offs, with flight tracking so we're there when you land,
                not when the schedule said we would be.</p>
              <a class="card-link" href="/book?occasion=Airport%20Transfers">Book this ride <svg
                  viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="3" y="7" width="18" height="13" rx="2" />
                  <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  <path d="M3 12h18" />
                </svg></div>
              <h3>Corporate &amp; Executive Travel</h3>
              <p>Discreet, on-time transport for meetings, roadshows and client visits — a quiet space to make your last
                calls before you arrive.</p>
              <a class="card-link" href="/book?occasion=Corporate%20%26%20Executive%20Travel">Book this ride
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <circle cx="9" cy="14" r="5" />
                  <circle cx="15" cy="14" r="5" />
                </svg></div>
              <h3>Weddings</h3>
              <p>A precisely-timed ride for the wedding party, from the getting-ready suite to the ceremony to the
                send-off — we'll work straight off your timeline.</p>
              <a class="card-link" href="/book?occasion=Weddings">Book this ride <svg viewBox="0 0 24 24"
                  fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M2 9l10-5 10 5-10 5-10-5z" />
                  <path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
                </svg></div>
              <h3>Prom &amp; Graduation</h3>
              <p>Safe, supervised group transport that still feels like a big night — parents included on the itinerary
                if you'd like.</p>
              <a class="card-link" href="/book?occasion=Prom%20%26%20Graduation">Book this ride <svg
                  viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="3" y="8" width="18" height="4" />
                  <rect x="3" y="12" width="18" height="9" />
                  <path d="M12 8v13" />
                  <path d="M12 8c0-2.5-2-4.5-4-4.5S6 5.5 8 7l4 1z" />
                  <path d="M12 8c0-2.5 2-4.5 4-4.5S18 5.5 16 7l-4 1z" />
                </svg></div>
              <h3>Birthdays &amp; Anniversaries</h3>
              <p>Mark the milestone properly — limousine for an intimate dinner run, party bus if the whole group's
                coming along.</p>
              <a class="card-link" href="/book?occasion=Birthdays%20%26%20Anniversaries">Book this ride <svg
                  viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M5 3h14l-7 8v7" />
                  <path d="M9 21h6" />
                </svg></div>
              <h3>Bachelor &amp; Bachelorette Parties</h3>
              <p>You plan the night, we handle the driving — hotel to dinner to the next stop, on your group's schedule.
              </p>
              <a class="card-link" href="/book?occasion=Bachelor%20%26%20Bachelorette%20Parties">Book this
                ride <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M9 18V5l12-2v13" />
                  <circle cx="6" cy="18" r="3" />
                  <circle cx="18" cy="16" r="3" />
                </svg></div>
              <h3>Concerts &amp; Sporting Events</h3>
              <p>Skip the parking lot search entirely — we'll drop you at the door and be waiting when the final buzzer
                sounds.</p>
              <a class="card-link" href="/book?occasion=Concerts%20%26%20Sporting%20Events">Book this ride
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M7 3h10" />
                  <path d="M12 3c0 4-4 4-4 8a4 4 0 0 0 8 0c0-4-4-4-4-8" />
                  <path d="M12 15v6" />
                  <path d="M9 21h6" />
                </svg></div>
              <h3>Wine &amp; Brewery Tours</h3>
              <p>An easy loop through Fraser Valley wineries and craft breweries — nobody has to count their pours.</p>
              <a class="card-link" href="/book?occasion=Wine%20%26%20Brewery%20Tours">Book this ride <svg
                  viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M3 20l6-11 4 7 3-5 5 9z" />
                </svg></div>
              <h3>Whistler Ski &amp; Resort Trips</h3>
              <p>Let someone else handle the Sea-to-Sky Highway. Gear fits fine, and you'll actually get to enjoy the
                drive up.</p>
              <a class="card-link" href="/book?occasion=Whistler%20Ski%20%26%20Resort%20Trips">Book this ride
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M12 2l2 7h7l-5.5 4.5L17 21l-5-4-5 4 1.5-7.5L3 9h7z" />
                </svg></div>
              <h3>Quinceañeras &amp; Celebrations</h3>
              <p>An entrance that matches the occasion — decorated to the extent you'd like, timed exactly to your event
                schedule.</p>
              <a class="card-link" href="/book?occasion=Quincea%C3%B1eras%20%26%20Celebrations">Book this
                ride <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="10" rx="2" />
                  <circle cx="7" cy="19" r="1.6" />
                  <circle cx="17" cy="19" r="1.6" />
                  <path d="M2 12h20" />
                </svg></div>
              <h3>Party Bus Nights Out</h3>
              <p>LED lighting and a proper sound system for a group night on the town — birthdays, reunions, or just
                because.</p>
              <a class="card-link" href="/book?occasion=Party%20Bus%20Nights%20Out">Book this ride <svg
                  viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path
                    d="M12 22c4 0 6-3 6-6.5C18 12 15 9 14 6c-.5 3-2 4-3 6-1-1-1.5-2.5-1.5-4C7 9 6 12.5 6 15.5 6 19 8 22 12 22z" />
                </svg></div>
              <h3>Funeral &amp; Memorial Transportation</h3>
              <p>Quiet, respectful transport for services and processions, handled with the care the day calls for.</p>
              <a class="card-link" href="/book?occasion=Funeral%20%26%20Memorial%20Transportation">Book this
                ride <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

            <div class="card reveal">
              <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3.5 2" />
                </svg></div>
              <h3>Hourly &amp; Point-to-Point Charter</h3>
              <p>Book us by the hour or for a single point-to-point run — flexible for whatever shape your day takes.
              </p>
              <a class="card-link" href="/book?occasion=Hourly%20%26%20Point-to-Point%20Charter">Book this
                ride <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg></a>
            </div>

          </div>
        </div>
      </section>

      <section class="service-gallery-section">
        <div class="container">
          <div class="section-head">
            <div class="stack">
              <p class="eyebrow">Travel in style</p>
              <h2>See Your Ride Before You Book.</h2>
            </div>
            <p class="lede">From the polished exterior to the party-ready interior, every ride is prepared for a
              memorable occasion.</p>
          </div>

          <div class="service-gallery">
            <figure class="service-gallery-feature reveal">
              <img src="/images/services/surrey-stretch-limousine-rental.webp"
                alt="White Posh Passage limousine parked outside" loading="lazy">
              <figcaption><span>Posh Passage Limousines</span><strong>Make an entrance.</strong></figcaption>
            </figure>
            <div class="service-gallery-side">
              <figure class="reveal">
                <img src="/images/services/vancouver-party-bus-interior.webp"
                  alt="Limousine interior with leather seating, bar service and LED lighting" loading="lazy">
                <figcaption>Party-ready interior</figcaption>
              </figure>
              <figure class="reveal">
                <img src="/images/services/yvr-airport-limo-transfer.webp"
                  alt="Spacious party bus interior with leather seating and ambient lighting" loading="lazy">
                <figcaption>Room for the whole group</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <section class="cta-band">
        <div class="container">
          <p class="eyebrow center">Not Sure What You Need?</p>
          <h2>We'll Help You Figure It Out.</h2>
          <p class="lede center">Call us with your date and headcount and we'll match you to the right vehicle in a
            couple of minutes.</p>
          <div class="hero-actions">
            <a href="tel:+16723773932" class="btn btn-primary">Call (672) 377-3932</a>
            <a href="/book" class="btn btn-ghost">Book Online Instead</a>
          </div>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <svg class="footer-skyline" viewBox="0 0 1440 400" fill="none" xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true" preserveAspectRatio="xMidYMax slice">
        <path
          d="M0,260 L90,185 L170,225 L250,150 L330,205 L430,135 L525,215 L620,165 L715,235 L810,175 L905,225 L1000,155 L1100,215 L1200,185 L1300,235 L1440,195 L1440,400 L0,400 Z"
          fill="#12141a" />
        <path
          d="M0,400 L0,322 C60,300 140,330 220,308 C300,288 360,268 440,290 C520,310 580,300 640,280 C702,260 742,270 780,292 L780,400 Z"
          fill="#0a0b0f" />
        <g fill="#0a0b0f">
          <rect x="788" y="252" width="38" height="148" />
          <rect x="834" y="300" width="28" height="100" />
          <rect x="872" y="222" width="48" height="178" />
          <rect x="930" y="270" width="34" height="130" />
          <rect x="974" y="182" width="58" height="218" />
          <rect x="1042" y="262" width="30" height="138" />
          <rect x="1082" y="308" width="44" height="92" />
          <rect x="1136" y="240" width="34" height="160" />
          <rect x="1180" y="286" width="54" height="114" />
          <rect x="1244" y="252" width="30" height="148" />
          <rect x="1284" y="316" width="40" height="84" />
          <rect x="1334" y="266" width="48" height="134" />
          <rect x="1392" y="304" width="30" height="96" />
        </g>
      </svg>
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <a href="/home" class="brand">
              <img class="brand-mark" src="/images/posh-passage-logo.png" alt="">
              <span class="brand-word">Posh Passage<span>LIMOUSINES</span></span>
            </a>
            <p>Chauffeured limousines and party buses across the Lower Mainland, the Fraser Valley and the Sea-to-Sky
              corridor — available around the clock.</p>
          </div>
          <div class="footer-col">
            <h4>Explore</h4>
            <ul>
              <li><a href="/about">About Us</a></li>
              <li><a href="/service">Services</a></li>
              <li><a href="/fleet">Our Fleet</a></li>
              <li><a href="/faq">FAQ</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Book</h4>
            <ul>
              <li><a href="/book">Book a Ride</a></li>
              <li><a href="/contact">Contact Us</a></li>
              <li><a href="tel:+16723773932">(672) 377-3932</a></li>
              <li><a href="mailto:poshpassagelimosines@gmail.com">Email Us</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Service Area</h4>
            <ul>
              <li>Metro Vancouver</li>
              <li>Fraser Valley &amp; Chilliwack</li>
              <li>Squamish &amp; Whistler</li>
              <li>USA Seattle Airport</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© <span data-year></span> Posh Passage Limousines. All rights reserved.</span>
          <span>1959 152 St, Surrey, BC</span>
        </div>
      </div>
    </footer>

