2:T1659,
        <header class="site-header">
            <div class="container"><a href="/home" class="brand"><img class="brand-mark"
                        src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                        Passage<span>LIMOUSINES</span></span></a>
                <nav class="nav-primary"><a href="/home">Home</a><a href="/about">About</a><a
                        href="/service">Services</a><a href="/fleet">Fleet</a><a href="/book">Book a
                        Ride</a><a href="/faq">FAQ</a><a href="/contact">Contact</a></nav>
                <div class="header-actions"><a href="tel:+16723773932" class="call-chip">(672) 377-3932</a><a
                        href="/book?occasion=Whistler%20Ski%20%26%20Resort%20Trips"
                        class="btn btn-primary btn-sm">Book a Ride</a><button class="nav-toggle"
                        aria-label="Toggle menu" aria-expanded="false"><span></span></button></div>
            </div>
        </header>
        <main>
            <section class="page-hero">
                <div class="container">
                    <p class="eyebrow">Sea to Sky Transfers</p>
                    <h1>Whistler Limo Service Along the Sea to Sky.</h1>
                    <p class="lede">Make the journey north part of the experience. Travel privately from Surrey or Metro
                        Vancouver to Whistler with room for your group, gear and plans.</p>
                    <div class="hero-actions"><a href="/book?occasion=Whistler%20Ski%20%26%20Resort%20Trips"
                            class="btn btn-primary">Book a Whistler Transfer</a><a href="tel:+16723773932"
                            class="btn btn-ghost">Call (672) 377-3932</a></div>
                </div>
            </section>
            <section>
                <div class="container">
                    <div class="section-head">
                        <div class="stack">
                            <p class="eyebrow">A better way north</p>
                            <h2>Relax into the Sea to Sky drive.</h2>
                        </div>
                    </div>
                    <div class="grid grid-3">
                        <article class="card">
                            <h3>Private door-to-door service</h3>
                            <p>Start at your home, hotel or airport and arrive at your Whistler accommodation without
                                coordinating multiple vehicles.</p>
                        </article>
                        <article class="card">
                            <h3>Room for your gear</h3>
                            <p>Tell us about your skis, boards and luggage when you book so we can recommend the right
                                vehicle for the trip.</p>
                        </article>
                        <article class="card">
                            <h3>Return trips planned</h3>
                            <p>Schedule a one-way transfer or a return journey around your resort stay, event, wedding
                                or weekend away.</p>
                        </article>
                    </div>
                </div>
            </section>
            <section class="cta-band">
                <div class="container">
                    <p class="eyebrow center">Surrey to Whistler</p>
                    <h2>Plan the whole journey.</h2>
                    <p class="lede center">Send your travel date, pickup location and group size for a private Sea to
                        Sky transfer quote.</p>
                    <div class="hero-actions"><a href="/book?occasion=Whistler%20Ski%20%26%20Resort%20Trips"
                            class="btn btn-primary">Request a Quote</a><a href="/contact"
                            class="btn btn-ghost">Contact Us</a></div>
                </div>
            </section>
        </main>
        <footer class="site-footer">
            <div class="container">
                <div class="footer-top">
                    <div class="footer-brand"><a href="/home" class="brand"><img class="brand-mark"
                                src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                                Passage<span>LIMOUSINES</span></span></a>
                        <p>Chauffeured limousines and party buses across Surrey, Metro Vancouver, the Fraser Valley and
                            Whistler.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <ul>
                            <li><a href="/service">Services</a></li>
                            <li><a href="/fleet">Our Fleet</a></li>
                            <li><a href="/faq">FAQ</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Book</h4>
                        <ul>
                            <li><a href="/book">Book a Ride</a></li>
                            <li><a href="tel:+16723773932">(672) 377-3932</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Address</h4>
                        <ul>
                            <li>1959 152 St</li>
                            <li>Surrey, BC</li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom"><span>© <span data-year></span> Posh Passage Limousines. All rights
                        reserved.</span><span>1959 152 St, Surrey, BC</span></div>
            </div>
        </footer>
