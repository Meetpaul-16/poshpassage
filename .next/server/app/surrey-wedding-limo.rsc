        <header class="site-header">
            <div class="container">
                <a href="/home" class="brand"><img class="brand-mark" src="/images/posh-passage-logo.png"
                        alt=""><span class="brand-word">Posh Passage<span>LIMOUSINES</span></span></a>
                <nav class="nav-primary">
                    <a href="/home">Home</a><a href="/about">About</a><a href="/service">Services</a><a
                        href="/fleet">Fleet</a><a href="/book">Book a Ride</a><a
                        href="/faq">FAQ</a><a href="/contact">Contact</a>
                </nav>
                <div class="header-actions"><a href="tel:+16723773932" class="call-chip">(672) 377-3932</a><a
                        href="/book?occasion=Weddings" class="btn btn-primary btn-sm">Book a Ride</a><button
                        class="nav-toggle" aria-label="Toggle menu" aria-expanded="false"><span></span></button></div>
            </div>
        </header>

        <main>
            <section class="page-hero">
                <div class="container">
                    <p class="eyebrow">Weddings in Surrey</p>
                    <h1>Wedding Limousine Rental in Surrey, BC.</h1>
                    <p class="lede">Arrive together, on time, and ready for the moment. Posh Passage coordinates elegant
                        wedding transportation around your ceremony and reception timeline.</p>
                    <div class="hero-actions"><a href="/book?occasion=Weddings" class="btn btn-primary">Plan
                            Your Wedding Ride</a><a href="tel:+16723773932" class="btn btn-ghost">Call (672)
                            377-3932</a></div>
                </div>
            </section>
            <section>
                <div class="container">
                    <div class="section-head">
                        <div class="stack">
                            <p class="eyebrow">Made for the day</p>
                            <h2>A calm ride between every important moment.</h2>
                        </div>
                    </div>
                    <div class="grid grid-3">
                        <article class="card">
                            <h3>Wedding party transport</h3>
                            <p>Keep the wedding party moving between getting-ready locations, photos, the ceremony and
                                the reception with a chauffeur who follows your schedule.</p>
                        </article>
                        <article class="card">
                            <h3>Guest transfers</h3>
                            <p>Make arrivals simple for out-of-town guests and family with coordinated transportation
                                from Surrey hotels, venues and nearby communities.</p>
                        </article>
                        <article class="card">
                            <h3>Elegant arrival</h3>
                            <p>Choose a stretch limousine or party bus that gives your entrance the right sense of
                                occasion while keeping the day comfortable.</p>
                        </article>
                    </div>
                </div>
            </section>
            <section class="cta-band">
                <div class="container">
                    <p class="eyebrow center">Your date, your route</p>
                    <h2>Let's build the wedding itinerary.</h2>
                    <p class="lede center">Share your locations, timing and group size for a tailored wedding
                        transportation quote.</p>
                    <div class="hero-actions"><a href="/book?occasion=Weddings"
                            class="btn btn-primary">Request a Quote</a><a href="/contact"
                            class="btn btn-ghost">Contact Us</a></div>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <div class="container">
                <div class="footer-top">
                    <div class="footer-brand"><a href="/home" class="brand"><img class="brand-mark"
                                src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                                Passage<span>LIMOUSINES</span></span></a>
                        <p>Chauffeured limousines and party buses across Surrey, Metro Vancouver, the Fraser Valley and
                            Whistler.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <ul>
                            <li><a href="/service">Services</a></li>
                            <li><a href="/fleet">Our Fleet</a></li>
                            <li><a href="/faq">FAQ</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Book</h4>
                        <ul>
                            <li><a href="/book">Book a Ride</a></li>
                            <li><a href="tel:+16723773932">(672) 377-3932</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Address</h4>
                        <ul>
                            <li>1959 152 St</li>
                            <li>Surrey, BC</li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom"><span>© <span data-year></span> Posh Passage Limousines. All rights
                        reserved.</span><span>1959 152 St, Surrey, BC</span></div>
            </div>
        </footer>
