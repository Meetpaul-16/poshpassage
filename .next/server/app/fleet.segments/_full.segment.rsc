e:[["$","title","0",{"children":"Stretch Limousines & Party Buses in Surrey, BC | Posh Passage"}],["$","meta","1",{"name":"description","content":"Explore Posh Passage stretch limousines and party buses for weddings, airport transfers, group outings and events throughout the Lower Mainland."}],["$","link","2",{"rel":"canonical","href":"https://www.poshpassagelimousine.ca/fleet"}],["$","meta","3",{"property":"og:title","content":"Stretch Limousines & Party Buses in Surrey, BC | Posh Passage"}],["$","meta","4",{"property":"og:description","content":"Explore Posh Passage stretch limousines and party buses for weddings, airport transfers, group outings and events throughout the Lower Mainland."}],["$","meta","5",{"property":"og:type","content":"website"}],["$","meta","6",{"name":"twitter:card","content":"summary"}],["$","meta","7",{"name":"twitter:title","content":"Stretch Limousines & Party Buses in Surrey, BC | Posh Passage"}],["$","meta","8",{"name":"twitter:description","content":"Explore Posh Passage stretch limousines and party buses for weddings, airport transfers, group outings and events throughout the Lower Mainland."}],["$","link","9",{"rel":"icon","href":"/images/posh-passage-logo.png"}],["$","$L10","10",{}]]
11:T3d71,

    <header class="site-header">
      <div class="container">
        <a href="/home" class="brand">
          <img class="brand-mark" src="/images/posh-passage-logo.png" alt="">
          <span class="brand-word">Posh Passage<span>LIMOUSINES</span></span>
        </a>
        <nav class="nav-primary">
          <a href="/home">Home</a>
          <a href="/about">About</a>
          <a href="/service">Services</a>
          <a href="/fleet">Fleet</a>
          <a href="/book">Book a Ride</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
        </nav>
        <div class="header-actions">
          <a href="tel:+16723773932" class="call-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            (672) 377-3932
          </a>
          <a href="/book" class="btn btn-primary btn-sm">Book a Ride</a>
          <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false"><span></span></button>
        </div>
      </div>
    </header>

    <main>

      <section class="page-hero">
        <div class="container">
          <p class="eyebrow">Our Fleet</p>
          <h1>Stretch Limousines<br>&amp; Party Buses.</h1>
          <p class="lede">Refined and quiet, or loud and full of your favourite people. Exact vehicle availability
            varies by date — tell us your headcount and we'll confirm the right fit.</p>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="grid grid-2" style="align-items:stretch;">

            <div class="fleet-card limo reveal">
              <svg class="fleet-glyph" viewBox="0 0 24 24" fill="none" stroke="#b9bfca" stroke-width="1">
                <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5" />
                <rect x="2" y="13" width="20" height="6" rx="2" />
                <circle cx="7" cy="19" r="1.6" />
                <circle cx="17" cy="19" r="1.6" />
              </svg>
              <span class="tag">Classic Elegance</span>
              <h3>Stretch Limousine</h3>
              <p>Ideal for weddings, proms, anniversaries and airport arrivals that should feel like an event from the
                moment the door opens.</p>
              <div class="specs">
                <div><b>8–10</b><span>Passengers</span></div>
                <div><b>Leather</b><span>Interior</span></div>
                <div><b>24/7</b><span>Availability</span></div>
              </div>
              <ul class="amenities">
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Premium leather seating</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Ambient interior lighting</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Privacy divider</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Premium sound system</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Climate control</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Bottled water on request</li>
              </ul>
              <a href="/book?vehicle=Stretch%20Limousine" class="btn btn-primary btn-block">Reserve the
                Limousine</a>
            </div>

            <div class="fleet-card party reveal">
              <svg class="fleet-glyph" viewBox="0 0 24 24" fill="none" stroke="#b9bfca" stroke-width="1">
                <rect x="2" y="7" width="20" height="10" rx="2" />
                <circle cx="7" cy="19" r="1.6" />
                <circle cx="17" cy="19" r="1.6" />
                <path d="M2 12h20" />
              </svg>
              <span class="tag">Group Energy</span>
              <h3>Party Bus</h3>
              <p>Built for groups — birthdays, bachelor(ette) nights, prom groups and concerts. The night starts the
                second the doors close.</p>
              <div class="specs">
                <div><b>20–45</b><span>Passengers</span></div>
                <div><b>LED</b><span>Lighting</span></div>
                <div><b>24/7</b><span>Availability</span></div>
              </div>
              <ul class="amenities">
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Premium sound system</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> LED party lighting</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Open group seating</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Multiple entry points</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Climate control</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Ask about beverage service</li>
              </ul>
              <a href="/book?vehicle=Party%20Bus" class="btn btn-primary btn-block">Reserve the Party Bus</a>
            </div>

            <div class="fleet-card limo reveal">
              <svg class="fleet-glyph" viewBox="0 0 24 24" fill="none" stroke="#b9bfca" stroke-width="1">
                <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5" />
                <rect x="2" y="13" width="20" height="6" rx="2" />
                <circle cx="7" cy="19" r="1.6" />
                <circle cx="17" cy="19" r="1.6" />
              </svg>
              <span class="tag">Spacious Luxury</span>
              <h3>SUV Limousine</h3>
              <p>Room for the whole celebration, with the comfort and style that make weddings, proms and nights out
                feel exceptional.</p>
              <div class="specs">
                <div><b>14–16</b><span>Passengers</span></div>
                <div><b>Leather</b><span>Interior</span></div>
                <div><b>24/7</b><span>Availability</span></div>
              </div>
              <ul class="amenities">
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Premium leather seating</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Ambient interior lighting</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Premium sound system</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Spacious group seating</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Climate control</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Bottled water on request</li>
              </ul>
              <a href="/book?vehicle=SUV%20Limousine" class="btn btn-primary btn-block">Reserve the SUV
                Limousine</a>
            </div>

            <div class="fleet-card party reveal">
              <svg class="fleet-glyph" viewBox="0 0 24 24" fill="none" stroke="#b9bfca" stroke-width="1">
                <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5" />
                <rect x="2" y="13" width="20" height="6" rx="2" />
                <circle cx="7" cy="19" r="1.6" />
                <circle cx="17" cy="19" r="1.6" />
              </svg>
              <span class="tag">Flexible Group Travel</span>
              <h3>Sprinter</h3>
              <p>A polished, comfortable choice for airport transfers, corporate travel, winery tours and smaller groups
                travelling together.</p>
              <div class="specs">
                <div><b>10–14</b><span>Passengers</span></div>
                <div><b>Comfort</b><span>Seating</span></div>
                <div><b>24/7</b><span>Availability</span></div>
              </div>
              <ul class="amenities">
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Comfortable group seating</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Spacious luggage capacity</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Premium sound system</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Climate control</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Privacy-tinted windows</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg> Bottled water on request</li>
              </ul>
              <a href="/book?vehicle=Sprinter" class="btn btn-primary btn-block">Reserve the Sprinter</a>
            </div>

          </div>

          <p class="center" style="margin-top:40px; color:var(--fog); font-size:.92rem;">Not sure which one fits your
            group? <a href="tel:+16723773932" style="color:var(--ivory); text-decoration:underline;">Call (672)
              377-3932</a> and we'll help you decide.</p>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <svg class="footer-skyline" viewBox="0 0 1440 400" fill="none" xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true" preserveAspectRatio="xMidYMax slice">
