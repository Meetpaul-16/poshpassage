2:T1639,
        <header class="site-header">
            <div class="container"><a href="/home" class="brand"><img class="brand-mark"
                        src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                        Passage<span>LIMOUSINES</span></span></a>
                <nav class="nav-primary"><a href="/home">Home</a><a href="/about">About</a><a
                        href="/service">Services</a><a href="/fleet">Fleet</a><a href="/book">Book a
                        Ride</a><a href="/faq">FAQ</a><a href="/contact">Contact</a></nav>
                <div class="header-actions"><a href="tel:+16723773932" class="call-chip">(672) 377-3932</a><a
                        href="/book?occasion=Birthdays%20%26%20Anniversaries"
                        class="btn btn-primary btn-sm">Book a Ride</a><button class="nav-toggle"
                        aria-label="Toggle menu" aria-expanded="false"><span></span></button></div>
            </div>
        </header>
        <main>
            <section class="page-hero">
                <div class="container">
                    <p class="eyebrow">Group Celebrations</p>
                    <h1>Party Bus Rental from Surrey to Vancouver.</h1>
                    <p class="lede">Keep your group together for birthdays, concerts, bachelor and bachelorette parties,
                        sporting events and nights out across Metro Vancouver.</p>
                    <div class="hero-actions"><a href="/book?occasion=Birthdays%20%26%20Anniversaries"
                            class="btn btn-primary">Plan Your Party Bus</a><a href="tel:+16723773932"
                            class="btn btn-ghost">Call (672) 377-3932</a></div>
                </div>
            </section>
            <section>
                <div class="container">
                    <div class="section-head">
                        <div class="stack">
                            <p class="eyebrow">One vehicle, one group</p>
                            <h2>Make the route part of the celebration.</h2>
                        </div>
                    </div>
                    <div class="grid grid-3">
                        <article class="card">
                            <h3>Flexible pickup routes</h3>
                            <p>Start in Surrey, Langley or the Fraser Valley and travel into Vancouver, Burnaby,
                                Richmond or wherever the night takes you.</p>
                        </article>
                        <article class="card">
                            <h3>Comfortable group travel</h3>
                            <p>Give everyone a shared place to settle in between venues, with a professional chauffeur
                                handling the road.</p>
                        </article>
                        <article class="card">
                            <h3>Events of every size</h3>
                            <p>We will help match your headcount, itinerary and event style to the right limousine or
                                party bus from our fleet.</p>
                        </article>
                    </div>
                </div>
            </section>
            <section class="cta-band">
                <div class="container">
                    <p class="eyebrow center">Your night, your route</p>
                    <h2>Get the group moving.</h2>
                    <p class="lede center">Share your headcount, pickup points and stops for a party bus rental quote.
                    </p>
                    <div class="hero-actions"><a href="/book?occasion=Birthdays%20%26%20Anniversaries"
                            class="btn btn-primary">Request a Quote</a><a href="/fleet" class="btn btn-ghost">View
                            the Fleet</a></div>
                </div>
            </section>
        </main>
        <footer class="site-footer">
            <div class="container">
                <div class="footer-top">
                    <div class="footer-brand"><a href="/home" class="brand"><img class="brand-mark"
                                src="/images/posh-passage-logo.png" alt=""><span class="brand-word">Posh
                                Passage<span>LIMOUSINES</span></span></a>
                        <p>Chauffeured limousines and party buses across Surrey, Metro Vancouver, the Fraser Valley and
                            Whistler.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <ul>
                            <li><a href="/service">Services</a></li>
                            <li><a href="/fleet">Our Fleet</a></li>
                            <li><a href="/faq">FAQ</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Book</h4>
                        <ul>
                            <li><a href="/book">Book a Ride</a></li>
                            <li><a href="tel:+16723773932">(672) 377-3932</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Address</h4>
                        <ul>
                            <li>1959 152 St</li>
                            <li>Surrey, BC</li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom"><span>© <span data-year></span> Posh Passage Limousines. All rights
                        reserved.</span><span>1959 152 St, Surrey, BC</span></div>
            </div>
        </footer>
